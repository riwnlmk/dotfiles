set -uo pipefail

ENV_FILE="${HOME}/.arcmanenv"
COUNTRIES="Bangladesh,India,Singapore"
MIRROR_COUNT=10
PREVIEW_LIMIT=50
SYS_LOG="/var/log/pacman.log"
OUT_LOG="$(mktemp /tmp/pacman.XXXXXX)"
TG_LOG="/tmp/tg_send.log"

[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
BOT_TOKEN="${TG_BOT_TOKEN:-}"
CHAT_ID="${TG_CHAT_ID:-}"

esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

strip_ansi() { sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g'; }

send_telegram() {
  if [[ -z "$BOT_TOKEN" || -z "$CHAT_ID" ]]; then
    echo "Telegram: TG_BOT_TOKEN / TG_CHAT_ID not set, skipping."
    return 1
  fi

  local distro kernel msg
  distro="$(awk -F'"' '/^PRETTY_NAME=/{print $2}' /etc/os-release)"
  kernel="$(uname -r)"

  local body
  body="$(printf '%s' "$2" | strip_ansi | tail -c 2800)"

  msg="<b>$(esc "$1")</b>
<b>Kernel:</b> $(esc "$kernel")
<b>Host:</b> $(esc "$(uname -n)")
<b>User:</b> $(esc "$USER")
<b>Time:</b> $(esc "$(date '+%a %b %d, %Y %I:%M %p')")

<pre><code class=\"language-shell\">$(esc "$body")</code></pre>"

  if curl -sS --fail-with-body --retry 3 --retry-delay 2 --max-time 20 \
       -o "$TG_LOG" "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
       -d "chat_id=${CHAT_ID}" -d "parse_mode=HTML" \
       --data-urlencode "text=${msg}"; then
    echo "Telegram notification sent."
  else
    echo "Telegram notification failed. See $TG_LOG"
    return 1
  fi
}

sudo -v || exit 1

echo "==> Updating mirrorlist with reflector (speed test, may take 1-2 minutes)..."
MIRROR_TMP="$(mktemp /tmp/mirrorlist.XXXXXX)"
try_reflector() {
  reflector --verbose --latest "$MIRROR_COUNT" --protocol https --age 12 \
            --country "$COUNTRIES" --save "$MIRROR_TMP" "$@" \
    && [[ -s "$MIRROR_TMP" ]]
}

if try_reflector --sort rate --download-timeout 20 \
   || { echo "Speed test failed, falling back to score sort..."; try_reflector --sort score; }; then
  sudo cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
  sudo install -m 644 "$MIRROR_TMP" /etc/pacman.d/mirrorlist
  echo "Mirrorlist updated."
else
  echo "Reflector failed, keeping the existing mirrorlist."
fi
rm -f "$MIRROR_TMP"

echo "==> Running pacman -Syu..."
LOG_START="$(wc -l < "$SYS_LOG" 2>/dev/null || echo 0)"

sudo script -qefc "pacman -Syu" /dev/null | tee "$OUT_LOG"
PACMAN_EXIT="${PIPESTATUS[0]}"

if (( PACMAN_EXIT != 0 )); then
  send_telegram "Pacman upgrade FAILED" "$(tail -n 100 "$OUT_LOG")"
  echo "Pacman failed (exit $PACMAN_EXIT). Full output: $OUT_LOG"
  exit "$PACMAN_EXIT"
fi

mapfile -t UPDATED < <(
  tail -n +"$((LOG_START + 1))" "$SYS_LOG" 2>/dev/null \
    | sed -n 's/.*\[ALPM\] upgraded \(.*\) (\(.*\) -> \(.*\))$/\1 \2 -> \3/p'
)
COUNT="${#UPDATED[@]}"

if (( COUNT == 0 )); then
  LIST="No packages were updated."
else
  LIST="$(printf '%s\n' "${UPDATED[@]}" | head -n "$PREVIEW_LIMIT")"
  (( COUNT > PREVIEW_LIMIT )) && LIST+=$'\n... and '"$((COUNT - PREVIEW_LIMIT))"' more'
fi

send_telegram "Upgrade complete: ${COUNT} package(s)" "$LIST"

echo "----- Summary -----"
echo "Host: $(uname -n)"
echo "Packages updated: $COUNT"
echo "$LIST"
echo "Pacman output log: $OUT_LOG"